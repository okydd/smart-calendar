{
  "name": "smart-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node -e \"const fs=require('fs'); const p='dist/sw.js'; let s=fs.readFileSync(p,'utf8'); const t=new Date().toISOString().replace(/[:.]/g,'-'); s=s.replace(/__BUILD_TIME__/g,t); fs.writeFileSync(p,s); console.log('SW build time:', t);\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "antd": "^5.21.6",
    "dayjs": "^1.11.13",
    "lunar-javascript": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
